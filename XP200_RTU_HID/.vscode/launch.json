{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(gdb) Launch",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/primary/zephyr/zephyr.exe",
      "miDebuggerPath": "gdb",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Set Disassembly Flavor to Intel",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Zephyr Workbench Debug [primary]",
      "type": "cppdbg",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/build/primary/zephyr/zephyr.elf",
      "args": [],
      "stopAtEntry": true,
      "svdPath": "",
      "environment": [],
      "externalConsole": false,
      "serverLaunchTimeout": 30000,
      "filterStderr": true,
      "filterStdout": true,
      "serverStarted": "",
      "MIMode": "gdb",
      "miDebuggerPath": "${config:zephyr-workbench.sdk}/posix-zephyr-elf/bin/posix-zephyr-elf-gdb",
      "debugServerPath": "${workspaceFolder}/build/primary/.debug/west_wrapper.sh",
      "debugServerArgs": "",
      "setupCommands": [
        {
          "text": "-target-select remote localhost:3333",
          "description": "connect to target",
          "ignoreFailures": false
        },
        {
          "text": "-interpreter-exec console \"monitor reset\"",
          "ignoreFailures": false
        },
        {
          "text": "-target-download",
          "description": "flash target",
          "ignoreFailures": false
        },
        {
          "text": "set breakpoint pending on",
          "description": "Set pending",
          "ignoreFailures": false
        },
        {
          "text": "tbreak main",
          "description": "Set a breakpoint at main",
          "ignoreFailures": true
        }
      ],
      "logging": {
        "moduleLoad": true,
        "trace": true,
        "engineLogging": true,
        "programOutput": true,
        "exceptions": true
      }
    }
  ]
}